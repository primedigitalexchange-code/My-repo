# Example environment variables for QuickBooks Payments demo
# Copy to .env and fill in with your app's credentials before running
PORT=3000

# Intuit OAuth2 app credentials (sandbox)
INTUIT_CLIENT_ID=YOUR_INTUIT_CLIENT_ID
INTUIT_CLIENT_SECRET=YOUR_INTUIT_CLIENT_SECRET

# Redirect URI you register in your Intuit app (e.g., http://localhost:3000/auth/callback)
INTUIT_REDIRECT_URI=http://localhost:3000/auth/callback

# Intuit endpoints (defaults are sandbox; confirm with Intuit docs)
INTUIT_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
INTUIT_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer

# QuickBooks Online base API (sandbox)
QBO_API_BASE=https://sandbox-quickbooks.api.intuit.com/v3/company

# QuickBooks Payments API base (sandbox) - confirm exact base path in docs
PAYMENTS_API_BASE=https://sandbox.api.intuit.com/quickbooks/v4/payments

# A simple in-memory store key (not for production)
SESSION_SECRET=change_this_in_production
